<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!-- Credential Offer 테이블 -->
    <changeSet id="create-t_oid4vc_offer" author="oid4vc-team">
        <createTable tableName="t_oid4vc_offer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="offer_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="pre_auth_code" type="VARCHAR(128)"/>
            <column name="user_pin" type="VARCHAR(256)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- CNonce 테이블 -->
    <changeSet id="create-t_oid4vc_cnonce" author="oid4vc-team">
        <createTable tableName="t_oid4vc_cnonce">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cnonce" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Preauthorized Code 테이블 -->
    <changeSet id="create-t_oid4vc_pre_auth_code" author="oid4vc-team">
        <createTable tableName="t_oid4vc_pre_auth_code">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="VARCHAR(128)"/>
            <column name="user_pin" type="VARCHAR(256)"/>
            <column name="scopes" type="TEXT"/>
            <column name="consumed" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 세션 매핑 테이블 -->
    <changeSet id="create-t_oid4vc_session_map" author="oid4vc-team">
        <createTable tableName="t_oid4vc_session_map">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_key" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="session_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 지연 발급 트랜잭션 테이블 -->
    <changeSet id="create-t_oid4vc_deferred_transaction" author="oid4vc-team">
        <createTable tableName="t_oid4vc_deferred_transaction">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="transaction_id" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="request_json" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 클라이언트 테이블 -->
    <changeSet id="create-t_oid4vc_client" author="oid4vc-team">
        <createTable tableName="t_oid4vc_client">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="client_secret" type="VARCHAR(256)"/>
            <column name="redirect_uri" type="VARCHAR(512)"/>
            <column name="client_name" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 사용자 자격증명 매핑 테이블 -->
    <changeSet id="create-t_oid4vc_user_credential_map" author="oid4vc-team">
        <createTable tableName="t_oid4vc_user_credential_map">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="config_id" type="VARCHAR(128)">
                 <constraints nullable="false"/>
            </column>
            <column name="credential_id" type="VARCHAR(128)">
                 <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 알림 테이블 -->
    <changeSet id="create-t_oid4vc_notification" author="oid4vc-team">
        <createTable tableName="t_oid4vc_notification">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="notification_id" type="VARCHAR(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="transaction_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(50)"/>
            <column name="event_description" type="VARCHAR(256)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 사용자별 동적 Claim 설정 테이블 -->
    <changeSet id="create-t_oid4vc_user_claims" author="oid4vc-team">
        <createTable tableName="t_oid4vc_user_claims">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="credential_type" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="claims" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                 <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="t_oid4vc_user_claims" columnNames="user_id, credential_type" constraintName="uk_user_claims_id_type"/>
    </changeSet>

    <changeSet id="create-t_oid4vc_webview_issuance_session" author="oid4vc-team">
        <createTable tableName="t_oid4vc_webview_issuance_session">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_token" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="csrf_token" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="credential_configuration_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="credential_type" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(24)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="credential_offer_uri" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    </databaseChangeLog>
