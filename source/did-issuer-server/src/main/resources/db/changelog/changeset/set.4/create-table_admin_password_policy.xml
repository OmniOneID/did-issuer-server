<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

  <changeSet id="create-table-admin-password-policy" author="omnione">
    <createTable tableName="admin_password_policy">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="min_length" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="require_uppercase" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="require_number" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="require_special" type="BOOLEAN">
        <constraints nullable="false"/>
      </column>
      <column name="password_expiry_days" type="SMALLINT">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
    </createTable>

    <insert tableName="admin_password_policy">
      <column name="min_length" value="8"/>
      <column name="require_uppercase" valueBoolean="false"/>
      <column name="require_number" valueBoolean="false"/>
      <column name="require_special" valueBoolean="false"/>
      <column name="password_expiry_days" value="365"/>
      <column name="created_at" valueComputed="NOW()"/>
    </insert>
  </changeSet>

</databaseChangeLog>
